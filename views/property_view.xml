<odoo>
    <!-- 1. واجهة القائمة List View (Odoo 19) -->
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property.list</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <list>
                <field name="owner_id"/>
                <field name="postcode"/>
                <field name="name"/>
                <field name="date_availability"/>
                <field name="selling_price"/>
                <field name="state"/>
                <field name="garden"/>
                <field name="bedroom" optional="show"/>
                <field name="garage" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- 2. واجهة النموذج Form View (Odoo 19) -->
    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property.form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form>
                <!-- الـ header خارج الـ sheet -->
                <header>
                    <button name="action_draft" type="object" class="btn-primary" string="Draft" invisible="state == 'draft'"/>
                    <button name="action_pending" type="object" class="btn-secondary" string="Pending" invisible="state != 'draft'"/>
                    <button name="action_sold" type="object" class="btn-success" string="Sold" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,sold"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Property Name"/>
                        </h1>
                    </div>

                    <group>
                        <!-- العمود الأول (يسار) -->
                        <group string="GENERAL INFO.">
                            <field name="date_availability" required="1"/>
                            <field name="postcode"/>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="diff"/>
                            <field name="bedroom"/>
                            <field name="living_area"/>
                            <field name="facades"/>
                        </group>

                        <!-- العمود الثاني (يمين) -->
                        <group string="ADDITIONAL INFO.">
                            <field name="owner_id"/>
                            <field name="owner_address"/>
                            <field name="owner_phone"/>
                            <field name="garden"/>
                            <field name="garage"/>
                            <field name="garden_orientation"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>
                </sheet>

                <!-- الـ Chatter في Odoo 19 ينزل بالأسفل تلقائياً بمجرد إضافة <chatter/> خارج الـ sheet -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 3. الأكشن Action -->
    <record id="property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">property</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 4. البحث Search View -->
    <record id="property_view_search" model="ir.ui.view">
        <field name="name">property.search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <field name="postcode"/>
                <field name="name"/>
                <filter name="is_garden" string="With Garden" domain="[('garden','=',True)]"/>
                <filter name="is_garage" string="With Garage" domain="[('garage','=',True)]"/>
                <filter name="group_garden" string="Garden" context="{'group_by':'garden'}"/>
            </search>
        </field>
    </record>

    <!-- 5. القائمة Menu -->
    <menuitem
        id="property_menu_item"
        name="Properties"
        parent="properties_menu"
        action="property_action"
    />
</odoo>