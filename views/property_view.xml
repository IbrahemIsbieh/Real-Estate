<odoo>
    <!-- 1. واجهة القائمة List View (Odoo 19) -->
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property.list</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <list class="header_custom" decoration-danger="(is_late)">
                <field name="owner_id"/>
                <field name="postcode"/>
                <field name="name"/>
                <field name="date_availability"/>
                <field name="expected_selling_date"/>
                <field name="selling_price"/>
                <field name="is_late" invisible="1"/>
                <field name="state"/>
                <field name="garden"/>
                <field name="active"/>
                <field name="bedroom" optional="show"/>
                <field name="garage" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- 2. واجهة النموذج Form View (Odoo 19) -->
    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property.form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form>
                <!-- الـ header خارج الـ sheet -->
                <header>

                    <button name="action" type="object" class="btn-success" string="Action"  />
                    <button name="get_properties" type="object" class="btn-secondary" string="Tests Call Get properties"  />
                    <button name="action_draft" type="object" class="btn-primary" string="Draft" invisible="state in ('draft','closed')" />
                    <button name="action_pending" type="object" class="btn-secondary" string="Pending" invisible="state != 'draft'"/>
                    <button name="action_sold" type="object" class="btn-success" string="Sold" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,sold,closed"/>
                </header>

                <sheet>
                    <div name="button_box" class="oe_button_box">

                        <button name="action_open_related_owner" type="object" icon="fa-user" string="Owner" invisible="not owner_id"  />

                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Sold" bg_color="text-bg-success" invisible="state != 'sold'"/>
                    <div class="oe_title">
                        <label for="ref"/>
                        <h1>
                            <field name="ref" readonly="state == 'closed'"/>
                        </h1>
                    </div>
                    <div class="oe_title">
                        <label for="name" />
                        <h3>
                            <field name="name" readonly="state == 'closed'"/>
                        </h3>
                    </div>
                    <group>
                        <!-- العمود الأول (يسار) -->
                        <group string="GENERAL INFO.">
                            <field name="create_time" readonly="1"  />
                            <field name="next_time"/>
                            <field name="date_availability" required="1" readonly="state == 'closed'"/>
                            <field name="postcode" readonly="state == 'closed'"/>
                            <field name="expected_price" readonly="state == 'closed'"/>
                            <field name="selling_price" readonly="state == 'closed'"/>
                            <field name="diff" readonly="state == 'closed'"/>
                            <field name="bedroom" readonly="state == 'closed'"/>
                            <field name="living_area" readonly="state == 'closed'"/>
                            <field name="facades" readonly="state == 'closed'"/>
                        </group>

                        <!-- العمود الثاني (يمين) -->
                        <group string="ADDITIONAL INFO.">
                            <field name="owner_id" readonly="state == 'closed'"/>
                            <field name="owner_address" readonly="state == 'closed'"/>
                            <field name="owner_phone" readonly="state == 'closed'"/>
                            <field name="garden" readonly="state == 'closed'"/>
                            <field name="garage" readonly="state == 'closed'"/>
                            <field name="garden_orientation" readonly="state == 'closed'"/>
                            <field name="tag_ids" widget="many2many_tags" readonly="state == 'closed'"/>
                            <field name="active" readonly="state == 'closed'"/>
                            <field name="expected_selling_date" readonly="state == 'closed'"/>
                            <field name="is_late" readonly="state == 'closed'"/>
                        </group>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>
  <!-- انا عملت ال property line واستخدمت editable مشان يسهل ادخال االبيانات وهاي هي الطريقة مشان تعمل line  -->
                    <notebook>
                        <page string="Bedrooms">
                            <field name="property_line_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="area"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

 <!-- الـ Chatter في Odoo 19 ينزل بالأسفل تلقائياً بمجرد إضافة <chatter/> خارج الـ sheet -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 3. الأكشن Action -->
    <record id="property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">property</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 4. البحث Search View -->
    <record id="property_view_search" model="ir.ui.view">
        <field name="name">property.search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <field name="postcode"/>
                <field name="name"/>
                <filter name="is_garden" string="With Garden" domain="[('garden','=',True)]"/>
                <filter name="is_garage" string="With Garage" domain="[('garage','=',True)]"/>
                <filter name="group_garden" string="Garden" context="{'group_by':'garden'}"/>
            </search>
        </field>
    </record>

    <!-- server actions record closed -->
    <record id="property_closed_server_action" model="ir.actions.server">
        <field name="name">Closed</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
            action = records.action_closed()
        </field>
     </record>

    <!-- server actions record change_state_wizard-->
    <record id="change_state_server_action" model="ir.actions.server">
        <field name="name">Change State</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
            action = records.action_open_change_state_wizard()
        </field>
     </record>

    <!-- Automated action record  -->
    <record id="property_selling_date_action_cron" model="ir.cron">
        <field name="name">property_selling_date</field>
        <field name="model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">model.check_expected_selling_date()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <!-- 5. القائمة Menu -->
    <menuitem
        id="property_menu_item"
        name="Properties"
        parent="properties_menu"
        action="property_action"
    />
</odoo>