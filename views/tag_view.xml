<odoo>
    <!-- 1. واجهة القائمة List View -->
    <record id="tag_view_tree" model="ir.ui.view">
        <field name="name">tag.list</field>
        <field name="model">tag</field>
        <field name="arch" type="xml">
            <list multi_edit="1" create="1" edit="1" delete="1">
                <field name="name"/>

            </list>
        </field>
    </record>

    <!-- 2. واجهة النموذج Form View -->
  <record id="tag_view_form" model="ir.ui.view">
    <field name="name">tag.form</field>
    <field name="model">tag</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <!-- العنوان الرئيسي -->
                <div class="oe_title">
                    <label for="name"/>
                    <h1>
                        <field name="name" required="1"/>
                    </h1>
                </div>
            </sheet>
        </form>
    </field>
</record>
    <!-- 3. الأكشن Action -->
    <record id="tag_action" model="ir.actions.act_window">
        <field name="name">Tag</field>
        <field name="res_model">tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 4. المنيو Menu -->
    <menuitem
        id="tag_menu_item"
        name="Tag"
        parent="Configation_menu"
        action="tag_action"
    />
</odoo>