<odoo>
    <!-- 1. واجهة القائمة List View (Odoo 19) -->
    <record id="building_view_tree" model="ir.ui.view">
        <field name="name">building.list</field>
        <field name="model">building</field>
        <field name="arch" type="xml">
            <list>
                <field name="no"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active"/>

            </list>
        </field>
    </record>

    <!-- 2. واجهة النموذج Form View (Odoo 19) -->
    <record id="building_view_form" model="ir.ui.view">
        <field name="name">building.form</field>
        <field name="model">building</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="no"/>
                        <field name="code"/>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="name"/>
                        <field name="active"/>

                    </group>
                </sheet>
                <chatter/>

            </form>
        </field>
    </record>
    <!-- 3. الأكشن Action -->
    <record id="building_action" model="ir.actions.act_window">
        <field name="name">Building</field>
        <field name="res_model">building</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 4. البحث Search View -->
    <record id="building_view_search" model="ir.ui.view">
        <field name="name">building.search</field>
        <field name="model">building</field>
        <field name="arch" type="xml">
            <search>
                <field name="no"/>


            </search>
        </field>
    </record>

    <!-- 5. القائمة Menu -->
    <menuitem
        id="building_menu_item"
        name="Building"
        parent="properties_menu"
        action="building_action"
    />
</odoo>