<odoo>
    <!-- 1. واجهة القائمة List View (Odoo 19) -->
    <record id="property_history_view_tree" model="ir.ui.view">
        <field name="name">property history list</field>
        <field name="model">property.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                 <field name="user_id"/>
                 <field name="property_id"/>
                 <field name="old_state"/>
                 <field name="new_state"/>

            </list>
        </field>
    </record>

    <!-- 2. واجهة النموذج Form View (Odoo 19) -->
    <record id="property_history_view_form" model="ir.ui.view">
        <field name="name">property history form</field>
        <field name="model">property.history</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                        <!-- العمود الأول (يسار) -->
                        <group >
                            <field name="user_id"/>
                            <field name="property_id"/>
                        </group>
                        <!-- العمود الثاني (يمين) -->
                        <group>
                            <field name="old_state"/>
                            <field name="new_state"/>
                            <field name="reason"/>

                        </group>
                        <notebook>
                            <page string="Bedrooms">
                                <field name="line_ids" readonly="1">
                                    <list >
                                        <field name="description"/>
                                        <field name="area"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                 </sheet>
            </form>
        </field>
    </record>

    <!-- 3. الأكشن Action -->
    <record id="property_history_action" model="ir.actions.act_window">
        <field name="name">Properties History</field>
        <field name="res_model">property.history</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- 5. القائمة Menu -->
    <menuitem
        id="property_history_menu_item"
        name="History"
        parent="properties_menu"
        action="property_history_action"
        groups="property_manager_group"
    />
</odoo>