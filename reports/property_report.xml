<odoo>
    <record id="property_report" model="ir.actions.report">
        <field name="name">property report</field>
        <field name="model">property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="binding_model_id" ref="model_property"/>
        <field name="binding_type" >report</field>
        <field name="report_name" >app_onee.property_report_template</field>
    </record>
    <template id="property_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                 <t t-foreach="docs" t-as="rec">
                     <div class="page">

                            <h1>Property Report</h1>

                            <br/>

                            <p>
                                <strong>Name:</strong>
                                <span t-field="rec.name"/>
                            </p>

                            <p>
                                <strong>Postcode:</strong>
                                <span t-field="rec.postcode"/>
                            </p>

                            <p>
                                <strong>Owner:</strong>
                                <span t-field="rec.owner_id"/>
                            </p>

                            <p>
                                <strong>phone:</strong>
                                <span t-field="rec.owner_id.phone"/>
                            </p>


                        </div>


                  </t>
            </t>
        </t>


    </template>
</odoo>